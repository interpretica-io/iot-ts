<?xml version="1.0" ?>
<package version="1.0">
    <description>MQTT client (tsf-mqtt): pub/sub latency and broker posture</description>
    <author mailto="maxim.menshikov@interpretica.io" />
    <session track_conf="silent">
        <!-- @page iot-mqtt-prologue MQTT Group Prologue
              @objective Prepare the MQTT group and report whether an MQTT
                         client is on the agent.

              @par Scenario:
              -# Open an RPC server and a job factory on the agent.
              -# RING whether tapi_mqtt_available() finds a client; leave the
                 SKIP decision to each test.
        -->
        <prologue>
            <script name="prologue">
                <objective>Prepare the MQTT group.</objective>
            </script>
        </prologue>

        <!-- @page iot-mqtt-epilogue MQTT Group Epilogue
              @objective Finalize the MQTT group.
        -->
        <epilogue>
            <script name="epilogue">
                <objective>Finalize the MQTT group.</objective>
            </script>
        </epilogue>

        <!-- @page iot-mqtt-pubsub Publish/subscribe round-trip latency
              @objective Round-trip a sweep of payload sizes through a broker
                         and graph the latency against payload size.

              @par Scenario:
              -# SKIP unless TSF_MQTT_HOST names a broker.
              -# Open an RPC server and a job factory on the agent.
              -# SKIP cleanly when there is no MQTT client on the agent.
              -# Round-trip each payload size (retained publish, then collect)
                 and record the latency.
              -# Emit the latency-vs-payload MI line graph.
        -->
        <run>
            <script name="pubsub">
                <objective>Round-trip payload sizes and graph the latency.</objective>
            </script>
        </run>

        <!-- @page iot-mqtt-audit Broker security posture
              @objective Find out what a broker lets a stranger do and gate
                         on the posture.

              @par Scenario:
              -# SKIP unless TSF_MQTT_HOST names a broker.
              -# Open an RPC server and a job factory on the agent.
              -# SKIP cleanly when there is no MQTT client on the agent.
              -# Read the broker posture into a report (anonymous access,
                 wildcard subscribe, no-TLS, $SYS/retained readable),
                 read-only with nothing published.
              -# Fail on a finding at least HIGH.
        -->
        <run>
            <script name="audit">
                <objective>Read the broker security posture and gate on it.</objective>
            </script>
        </run>

        <!-- @page iot-mqtt-fleet Two-agent device fleet
              @objective Drive a fleet of IoT device-clients on one agent
                         against a gateway broker on another, and confirm the
                         gateway ingests every device's telemetry.

              @par Scenario:
              -# Open an RPC server and job factory on Agt_A (gateway) and
                 Agt_B (fleet).
              -# SKIP unless both agents have an MQTT client.
              -# Stand an anonymous mosquitto broker up on Agt_A; SKIP if it
                 will not start.
              -# For each fleet size, publish one retained telemetry message
                 per device from Agt_B, then collect them all on the gateway.
              -# Fail if the gateway received fewer messages than devices.
              -# Graph publish throughput and ingest time against fleet size.

              @par Expected Results:
              - No broker/clients on the agents: SKIPPED.
              - Otherwise: every device's telemetry reaches the gateway.
        -->
        <run>
            <script name="fleet">
                <objective>
                    A fleet of device-clients on Agt_B against a gateway
                    broker on Agt_A; confirm full telemetry ingest.
                    @md
                </objective>
            </script>
        </run>
    </session>
</package>
